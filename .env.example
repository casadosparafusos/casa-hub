# Copiar para .env em producao (/opt/erp-wake/.env), preencher os valores
# reais e restringir permissao (chmod 600, chown erpwake:erpwake). Nunca
# commitar .env de verdade em lugar nenhum.

# --- Banco proprio desta integracao (independente da Reposicao) ---
DATABASE_PATH=/opt/erp-wake/data/app.db

# --- Chave mestra pra criptografar segredos gravados na tela de
# Configuracoes (WAKE_ADMIN_API_TOKEN, CISS_API_TOKEN -- AES-256-GCM, ver
# src/lib/crypto/secret-box.ts). Gerar uma vez com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NUNCA trocar depois de ja existir segredo gravado no banco -- invalida
# (fica ilegivel) tudo que ja foi salvo via UI.
SETTINGS_SECRET_KEY=

# --- CISS/PODER (leitura) ---
# Mesma base real ja usada pela Reposicao em producao (confirmada). Token e
# DEDICADO ao Casa Hub (gerado pelo SIGAS em 03/09/2026, cobre os endpoints
# /products/stock, /products/prices, /products/prices/{id} e
# /products/prices/search) -- NAO reaproveitar o token bruto de outra app:
# peça um novo ao SIGAS se precisar trocar (o token da Reposicao ja teve
# exposicao parcial em log, ver memoria ciss-token-exposicao-parcial-redacao).
# Desde 04/09/2026 pode ser gravado (criptografado, write-only) direto na
# tela de Configuracoes -- se gravado la, tem prioridade sobre esta env var.
CISS_BASE_URL=http://sigas.casadosparafusos.com:5099/api/ciss
CISS_API_TOKEN=

# --- Wake Commerce (Fbits) ---
# Reaproveita o mesmo token que o RD Gerencial ja usa pra pedidos --
# confirmado com acesso de LEITURA no endpoint de produtos via teste
# manual; escopo de ESCRITA ainda nao testado. Avaliar token dedicado se
# quiser isolar risco de lockout (5 throttles = 1h bloqueado) do sync de
# pedidos do RD Gerencial.
# Desde 04/09/2026 pode ser gravado (criptografado, write-only) direto na
# tela de Configuracoes -- se gravado la, tem prioridade sobre esta env var.
WAKE_ADMIN_API_TOKEN=

# --- Provider de preco CISS (ver src/lib/ciss/price-provider.ts) ---
# 'mock' em producao desde 04/09/2026 -- o token dedicado do CISS ainda nao
# tem o escopo `product_prices` liberado pelo SIGAS (401) e /products/stock
# retorna 500 por bug do lado deles. Ver docs/WAKE-API-CONTRATOS.md, secao
# "Bloqueio ativo no token CISS dedicado". So trocar pra 'live' depois que o
# SIGAS confirmar os dois problemas corrigidos.
CISS_PRICE_PROVIDER=mock

# --- Valores especificos de conta, NUNCA inventados (ver Configuracoes na UI) ---
# Podem ser setados aqui OU preenchidos via tela -- env var tem prioridade.
# WAKE_CD_ID=
# WAKE_STOCK_CONTROL_MODE=
# WAKE_PRICE_TABLE_ID=
# WAKE_PROMOTION_ID=
# CISS_STOCK_ENTERPRISE=
# CISS_STOCK_LOCATION=
# CSV_IDENTIFIER_TYPE=

# --- Regras de negocio (defaults da especificacao, sobrescrever so se pedido) ---
# UNIT_PRICE_MARKUP_PERCENT=20
# WHOLESALE_MIN_QTY=100
# STOCK_PERCENT=10
# RECONCILIATION_HOUR_LOCAL=3
