[Unit]
Description=Casa Hub (ERP -> Wake) -- worker de sincronizacao agendada
After=network.target

[Service]
Type=simple
User=erpwake
Group=erpwake
WorkingDirectory=/opt/erp-wake
EnvironmentFile=/opt/erp-wake/.env
Environment=PATH=/opt/erp-wake/.runtime/node/bin:/usr/bin:/bin
Environment=NODE_ENV=production
ExecStart=/opt/erp-wake/.runtime/node/bin/node /opt/erp-wake/node_modules/tsx/dist/cli.mjs --conditions=react-server worker/index.ts
Restart=always
RestartSec=5
Nice=10
MemoryMax=1G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
