{
  "name": "erp-wake-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Integracao ERP (CISS/PODER) -> Wake Commerce: preco e estoque, escopo fixadores/parafusos. Casa dos Parafusos.",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3001",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3001",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "tsx --conditions=react-server worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "db:seed-admin": "tsx --conditions=react-server scripts/seed-admin.ts",
    "wake:discover-ids": "tsx --conditions=react-server scripts/wake-discover-ids.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.38.4",
    "server-only": "^0.0.1",
    "zod": "^3.24.1",
    "next": "^15.5.23",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.2",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
